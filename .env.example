# DeepSeek
DEEPSEEK_API_KEY=

# Etherscan / BscScan unified API
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ETHERSCAN_API_KEY=

# GoPlus standard API credentials
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Market / address discovery
# DexScanner public read endpoints currently require no API key.
DEXSCANNER_ENABLED=true
DEXSCANNER_BASE_URL=https://dexscanner.io

# DEX Screener documented public search/token endpoints require no API key.
DEXSCREENER_ENABLED=true

# BscScan public web search fallback. This is best-effort because
# BscScan does not document a name-search API.
BSCSCAN_SEARCH_ENABLED=true

# Optional defaults
DEFAULT_MIN_TVL=50000
DEFAULT_MAX_TVL=1000000
DEFAULT_PROTOCOL_LIMIT=20

# DeepSeek cost controls
DEFAULT_AI_LIMIT=3
AI_MIN_SEVERITY_SCORE=30
AI_SOURCE_CHARS=45000
